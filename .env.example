# Copy to .env and fill in. .env is gitignored — never commit real values.

RUNPOD_API_KEY=

# Read token. The default NF4 repo is not gated, so no licence click needed.
HF_TOKEN=

IMAGE=ghcr.io/<your-github-username>/flux2-runpod-worker:0.1

# NF4-prequantized pipeline: ~34GB download, fits a 48GB GPU.
BASE_MODEL=diffusers/FLUX.2-dev-bnb-4bit
LORA_REPO=Guido/cartoon_lora
LORA_WEIGHT_NAME=my_first_lora_v2.safetensors
LORA_SCALE=1.0
DTYPE=bfloat16
QUANTIZE=none
OFFLOAD=1

MIN_VRAM_GB=48
WORKERS_MIN=0
WORKERS_MAX=1
IDLE_TIMEOUT=5

# Network volume — caches weights across cold starts, but bills hourly while it
# exists. Create with scripts/volume.py; delete with scripts/teardown.py --volume
VOLUME_SIZE_GB=60
DATA_CENTER_ID=EU-RO-1
NETWORK_VOLUME_ID=

RUNPOD_TEMPLATE_ID=
RUNPOD_ENDPOINT_ID=
